generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ✅ Кожне значення enum тепер на новому рядку
enum UserRole {
  ADMIN
  AGENT
}

enum ContactRole {
  BUYER
  SELLER
  BOTH
}

enum DealStage {
  LEAD
  VIEWING
  OFFER
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  CALL
  EMAIL
  SHOWING
  OFFER
  MEETING
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now())
}

model Company {
  id        String    @id @default(uuid())
  name      String
  domain    String?
  contacts  Contact[]
  deals     Deal[]
  createdAt DateTime  @default(now())
  @@index([name])
}

model Contact {
  id        String      @id @default(uuid())
  name      String
  email     String?
  phone     String?
  role      ContactRole @default(BUYER)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals     Deal[]
  createdAt DateTime    @default(now())
  @@index([companyId])
  @@index([email])
}

model Deal {
  id         String    @id @default(uuid())
  title      String    // Property address
  stage      DealStage @default(LEAD)
  amount     Decimal?  @db.Decimal(12, 2) // Price
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities Activity[]
  createdAt  DateTime  @default(now())
  @@index([companyId])
  @@index([stage]) // ✅ Ця помилка зникне, бо Prisma тепер розуміє, що stage - це скалярний тип (enum)
}

model Activity {
  id        String       @id @default(uuid())
  type      ActivityType
  note      String?
  dueAt     DateTime?
  dealId    String
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  @@index([dealId])
  @@index([dueAt])
}